{
  "_version": "1.76.0",
  "sap.app": {
    "id": "com.xtendhr.tilesexercise.tilesexercise",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "applicationVersion": {
      "version": "0.0.1"
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "resources": "resources.json",
    "sourceTemplate": {
      "id": "@sap/generator-fiori:basic",
      "version": "1.19.5",
      "toolsId": "f702c33a-066d-4744-b9d8-cb47ac0e8e63"
    },
    "dataSources": {
      "mainService": {
        "uri": "/V3/Northwind/Northwind.svc/",
        "type": "OData",
        "settings": {
          "annotations": [],
          "localUri": "localService/mainService/metadata.xml",
          "odataVersion": "2.0"
        }
      }
    },
    "crossNavigation": {
      "inbounds": {
        "TilesExercise-display": {
          "semanticObject": "TilesExercise",
          "action": "display",
          "title": "{{TilesExercise-display.flpTitle}}",
          "signature": {
            "parameters": {},
            "additionalParameters": "allowed"
          },
          "subTitle": "{{TilesExercise-display.flpSubtitle}}"
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "icons": {
      "icon": "",
      "favIcon": "",
      "phone": "",
      "phone@2": "",
      "tablet": "",
      "tablet@2": ""
    },
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "flexibilityServices": [],
    "flexEnabled": false,
    "dependencies": {
      "minUI5Version": "1.142.1",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {}
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "com.xtendhr.tilesexercise.tilesexercise.i18n.i18n"
        }
      },
      "": {
        "dataSource": "mainService",
        "preload": true,
        "settings": {}
      }
    },
    "resources": {
      "css": [
        {
          "uri": "css/style.css"
        }
      ]
    },
    "routing": {
      "config": {
        "routerClass": "sap.m.routing.Router",
        "controlAggregation": "pages",
        "controlId": "app",
        "transition": "slide",
        "type": "View",
        "viewType": "XML",
        "path": "com.xtendhr.tilesexercise.tilesexercise.view",
        "async": true,
        "viewPath": "com.xtendhr.tilesexercise.tilesexercise.view"
      },
      "routes": [
        {
          "name": "RouteHome",
          "pattern": "",
          "target": [
            "TargetHome"
          ]
        },
        {
          "name": "Products",
          "pattern": "Products:?productID:",
          "target": [
            "Products"
          ]
        },
        {
          "name": "Employees",
          "pattern": "Employees:?employeeID:",
          "target": [
            "Employees"
          ]
        }
      ],
      "targets": {
        "TargetHome": {
          "id": "Home",
          "name": "Home"
        },
        "Products": {
          "id": "Products",
          "name": "Products"
        },
        "Employees": {
          "id": "Employees",
          "name": "Employees"
        }
      }
    },
    "rootView": {
      "viewName": "com.xtendhr.tilesexercise.tilesexercise.view.App",
      "type": "XML",
      "id": "app",
      "async": true
    }
  }
}
