<core:FragmentDefinition xmlns:core="sap.ui.core" xmlns="sap.m" xmlns:l="sap.ui.layout"	xmlns:f="sap.ui.layout.form">
    <Dialog id="productViewDialog" closeOnNavigation="true" >
        <VBox class="sapUiSmallMargin">
            <f:Form id="productDialogFormView" editable="false">
			<f:layout>
				<f:ResponsiveGridLayout
					labelSpanXL="4"
					labelSpanL="4"
					labelSpanM="4"
					labelSpanS="4"
					adjustLabelSpan="true"
					emptySpanXL="0"
					emptySpanL="0"
					emptySpanM="0"
					emptySpanS="0"
					columnsXL="2"
					columnsL="2"
					columnsM="2"
					singleContainerFullSize="true" />
			</f:layout>
                <f:formContainers>
                    <f:FormContainer>
                        <f:formElements>
                            <f:FormElement label="{i18n>productFormName}">
                                <f:fields>
                                    <Text text="{dialogModel>/ProductName}" />
                                </f:fields>
                            </f:FormElement>
                            <f:FormElement label="{i18n>productFormSupplier}">
                                <f:fields>
                                    <Text text="{parts: [
                                        { path: 'dialogModel>/SupplierID' },
                                        { value: 'company' }
                                      ],
                                    formatter: '.formatterSupplier'}" />
                                </f:fields>
                            </f:FormElement>
                            <f:FormElement label="{i18n>productFormSupplierContact}">
                                <f:fields>
                                    <Text text="{parts: [
                                        { path: 'dialogModel>/SupplierID' },
                                        { value: 'contact' }
                                      ], formatter: '.formatterSupplier'}" />
                                </f:fields>
                            </f:FormElement>
                            <f:FormElement label="{i18n>productFormCategory}">
                                <f:fields>
                                    <!-- <Text text="{dialogModel>/Category/CategoryName}" /> -->
                                    <Text text="{path: 'dialogModel>/CategoryID', formatter: '.formatterCategoryName'}" />
                                </f:fields>
                            </f:FormElement>
                            <f:FormElement label="{i18n>productFormQuantityPerUnit}">
                                <f:fields>
                                    <Text text="{dialogModel>/QuantityPerUnit}" />
                                </f:fields>
                            </f:FormElement>
                            <f:FormElement label="{i18n>productFormUnitPrice}">
                                <f:fields>
                                    <Text text="${dialogModel>/UnitPrice}"/>
                                </f:fields>
                            </f:FormElement>
                        </f:formElements>
                    </f:FormContainer>
                    <f:FormContainer>
                        <f:formElements>
                            <f:FormElement label="{i18n>productFormUnitsStock}">
                                <f:fields>
                                    <Text text="{dialogModel>/UnitsInStock}" />
                                </f:fields>
                            </f:FormElement>
                            <f:FormElement label="{i18n>productFormUnitsOrder}">
                                <f:fields>
                                    <Text text="{dialogModel>/UnitsOnOrder}" />
                                </f:fields>
                            </f:FormElement>
                            <f:FormElement label="{i18n>productFormReorderLevel}">
                                <f:fields>
                                    <Text text="{dialogModel>/ReorderLevel}" />
                                </f:fields>
                            </f:FormElement>
                            <f:FormElement label="{i18n>productFormDiscontinued}" >
                                <f:fields>
                                    <CheckBox displayOnly="true" selected="{dialogModel>/Discontinued}" />
                                </f:fields>
                            </f:FormElement>
                        </f:formElements>
                    </f:FormContainer>
                </f:formContainers>
            </f:Form>
        </VBox>
        <buttons>
            <Button text="{i18n>formButtonClose}" press="onClose"/>
        </buttons>
    </Dialog>
</core:FragmentDefinition>