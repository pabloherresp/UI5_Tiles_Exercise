<core:FragmentDefinition xmlns:core="sap.ui.core" xmlns="sap.m" xmlns:l="sap.ui.layout"	xmlns:f="sap.ui.layout.form">
    <Dialog id="employeeFormDialog" closeOnNavigation="true" contentWidth="80%">
        <VBox class="sapUiSmallMargin">
            <f:Form id="employeeDialogFormEdit" editable="true">
			<f:layout>
				<f:ResponsiveGridLayout
					labelSpanXL="4"
					labelSpanL="4"
					labelSpanM="12"
					labelSpanS="12"
					adjustLabelSpan="true"
					emptySpanXL="0"
					emptySpanL="0"
					emptySpanM="0"
					emptySpanS="0"
					columnsXL="2"
					columnsL="2"
					columnsM="2"
					singleContainerFullSize="false" />
			</f:layout>
                <f:formContainers>
                    <f:FormContainer>
                        <f:formElements>
                            <f:FormElement label="{i18n>employeeFormName}">
                                <f:fields>
                                    <Input type="Text" placeholder="{i18n>employeeFormFirstName}" value="{dialogModel>/FirstName}" />
                                    <Input type="Text" placeholder="{i18n>employeeFormSurname}" value="{dialogModel>/LastName}" />
                                </f:fields>
                            </f:FormElement>
                            <f:FormElement label="{i18n>employeeFormTitle}">
                                <f:fields>
                                    <Input type="Text" value="{dialogModel>/Title}" />
                                </f:fields>
                            </f:FormElement>
                            <f:FormElement label="{i18n>employeeFormPhoneNumber}">
                                <f:fields>
                                    <Input type="Tel" value="{dialogModel>/HomePhone}" />
                                </f:fields>
                            </f:FormElement>
                            <f:FormElement label="{i18n>employeeFormBirthdate}">
                                <f:fields>
                                    <DatePicker value="{path: 'dialogModel>/BirthDate', formatter: '.formatDateToForm'}" displayFormat="dd-MM-yyyy"
                                    valueFormat="yyyy-MM-ddT00:00:00" placeholder="Enter Date" change="birthdateChange"/>
                                </f:fields>
                            </f:FormElement>
                            <f:FormElement label="{i18n>employeeFormHiringdate}">
                                <f:fields>
                                    <DatePicker  value="{path: 'dialogModel>/HireDate', formatter: '.formatDateToForm'}" displayFormat="dd-MM-yyyy"
                                    valueFormat="yyyy-MM-ddT00:00:00" placeholder="Enter Date" change="hiredateChange"/>
                                </f:fields>
                            </f:FormElement>
                        </f:formElements>
                    </f:FormContainer>
                    <f:FormContainer>
                        <f:formElements>
                            <f:FormElement label="{i18n>employeeFormAddress}">
                                <f:fields>
                                    <Input value="{dialogModel>/Address}" />
                                </f:fields>
                            </f:FormElement>
                            <f:FormElement label="{i18n>employeeFormCity}">
                                <f:fields>
                                    <Input type="Text" value="{dialogModel>/City}" />
                                </f:fields>
                            </f:FormElement>
                            <f:FormElement label="{i18n>employeeFormPostalCode}">
                                <f:fields>
                                    <Input type="Number" value="{dialogModel>/PostalCode}" />
                                </f:fields>
                            </f:FormElement>
                            <f:FormElement label="{i18n>employeeFormRegion}">
                                <f:fields>
                                    <Input value="{dialogModel>/Region}" />
                                </f:fields>
                            </f:FormElement>
                            <f:FormElement label="{i18n>employeeFormCountry}">
                                <f:fields>
                                    <Input value="{dialogModel>/Country}" />
                                </f:fields>
                            </f:FormElement>
                        </f:formElements>
                    </f:FormContainer>
                    <f:FormContainer>
                        <f:FormElement label="{i18n>employeeFormPhoto}">
                            <f:fields>
                            <Image src="{path: 'dialogModel>/Photo', formatter: '.formatImage'}" width="12rem" height="12rem" />
                            </f:fields>
                        </f:FormElement>
                    </f:FormContainer>
                </f:formContainers>
            </f:Form>
        </VBox>
        <buttons>
            <Button text="{i18n>formButtonSave}" type="Emphasized" press="onSave"/>
            <Button text="{i18n>formButtonClose}" press="onClose"/>
        </buttons>
    </Dialog>
</core:FragmentDefinition>