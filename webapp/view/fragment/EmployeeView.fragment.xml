<core:FragmentDefinition xmlns:core="sap.ui.core" xmlns="sap.m" xmlns:l="sap.ui.layout"	xmlns:f="sap.ui.layout.form">
    <Dialog id="employeeViewDialog" closeOnNavigation="true" contentWidth="80%">
        <VBox class="sapUiSmallMargin">
            <f:Form id="employeeDialogFormView" editable="true">
			<f:layout>
				<f:ResponsiveGridLayout
					labelSpanXL="4"
					labelSpanL="4"
					labelSpanM="6"
					labelSpanS="12"
					adjustLabelSpan="true"
					emptySpanXL="0"
					emptySpanL="0"
					emptySpanM="0"
					emptySpanS="0"
					columnsXL="2"
					columnsL="2"
					columnsM="2"
					singleContainerFullSize="true" />
			</f:layout>
                <f:formContainers>
                    <f:FormContainer>
                        <f:formElements>
                            <f:FormElement label="{i18n>employeeFormName}">
                                <f:fields>
                                    <Text text="{dialogModel>/FirstName} {dialogModel>/LastName}" />
                                </f:fields>
                            </f:FormElement>
                            <f:FormElement label="{i18n>employeeFormTitle}">
                                <f:fields>
                                    <Text text="{dialogModel>/Title}" />
                                </f:fields>
                            </f:FormElement>
                            <f:FormElement label="{i18n>employeeFormPhoneNumber}">
                                <f:fields>
                                    <Text text="{dialogModel>/HomePhone}" />
                                </f:fields>
                            </f:FormElement>
                            <f:FormElement label="{i18n>employeeFormBirthdate}">
                                <f:fields>
                                    <Text text="{path: 'dialogModel>/BirthDate', formatter: '.dateFormatter'}" />
                                </f:fields>
                            </f:FormElement>
                            <f:FormElement label="{i18n>employeeFormHiringdate}">
                                <f:fields>
                                    <Text text="{path: 'dialogModel>/HireDate', formatter: '.dateFormatter'}" />
                                </f:fields>
                            </f:FormElement>
                        </f:formElements>
                    </f:FormContainer>
                    <f:FormContainer>
                        <f:formElements>
                            <f:FormElement label="{i18n>employeeFormAddress}">
                                <f:fields>
                                    <Text text="{dialogModel>/Address}, {dialogModel>/City}" />
                                </f:fields>
                            </f:FormElement>
                            <f:FormElement label="{i18n>employeeFormPostalCode}">
                                <f:fields>
                                    <Text text="{dialogModel>/PostalCode}" />
                                </f:fields>
                            </f:FormElement>
                            <f:FormElement label="{i18n>employeeFormRegion}" visible="{= !!${dialogModel>/Region} }">
                                <f:fields>
                                    <Text text="{dialogModel>/Region}" />
                                </f:fields>
                            </f:FormElement>
                            <f:FormElement label="{i18n>employeeFormCountry}">
                                <f:fields>
                                    <Text text="{dialogModel>/Country}" />
                                </f:fields>
                            </f:FormElement>
                        </f:formElements>
                    </f:FormContainer>
                    <f:FormContainer>
                        <f:FormElement label="{i18n>employeeFormPhoto}">
                            <f:fields>
                            <Image src="{path: 'dialogModel>/Photo', formatter: '.formatImage'}" width="12rem" height="12rem" />
                            </f:fields>
                        </f:FormElement>
                    </f:FormContainer>
                </f:formContainers>
            </f:Form>
        </VBox>
        <buttons>
            <Button text="{i18n>formButtonClose}" press="onClose"/>
        </buttons>
    </Dialog>
</core:FragmentDefinition>