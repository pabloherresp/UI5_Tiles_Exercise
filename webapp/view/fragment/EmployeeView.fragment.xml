<core:FragmentDefinition xmlns:core="sap.ui.core" xmlns="sap.m" xmlns:l="sap.ui.layout"	xmlns:f="sap.ui.layout.form"
    controllerName="com.xtendhr.tilesexercise.tilesexercise.controller.EmployeeForm">
    <Dialog id="employeeViewDialog" closeOnNavigation="true" stretch="true" contentWidth="80%" contentHeight="80%">
        <VBox class="sapUiSmallMargin">
            <f:Form id="employeeDialogFormView" editable="false">
			<f:layout>
				<f:ResponsiveGridLayout
					labelSpanXL="4"
					labelSpanL="4"
					labelSpanM="4"
					labelSpanS="4"
					adjustLabelSpan="false"
					emptySpanXL="0"
					emptySpanL="0"
					emptySpanM="0"
					emptySpanS="0"
					columnsXL="2"
					columnsL="2"
					columnsM="2"
					singleContainerFullSize="false" />
			</f:layout>
                <f:formContainers>
                    <f:FormContainer>
                        <f:formElements>
                            <f:FormElement label="Name">
                                <f:fields>
                                    <Text text="{dialogModel>/FirstName} {dialogModel>/LastName}" />
                                </f:fields>
                            </f:FormElement>
                            <f:FormElement label="Title">
                                <f:fields>
                                    <Text text="{dialogModel>/Title}" />
                                </f:fields>
                            </f:FormElement>
                            <f:FormElement label="Phone Number">
                                <f:fields>
                                    <Text text="{dialogModel>/HomePhone}" />
                                </f:fields>
                            </f:FormElement>
                            <f:FormElement label="Birthdate">
                                <f:fields>
                                    <Text text="{path: 'dialogModel>/BirthDate', formatter: '.dateFormatter'}" />
                                </f:fields>
                            </f:FormElement>
                            <f:FormElement label="Hiring Date">
                                <f:fields>
                                    <Text text="{path: 'dialogModel>/HireDate', formatter: '.dateFormatter'}" />
                                </f:fields>
                            </f:FormElement>
                        </f:formElements>
                    </f:FormContainer>
                    <f:FormContainer>
                        <f:formElements>
                            <f:FormElement label="Address">
                                <f:fields>
                                    <Text text="{dialogModel>/Address}, {dialogModel>/City}" />
                                </f:fields>
                            </f:FormElement>
                            <f:FormElement label="Postal Code">
                                <f:fields>
                                    <Text text="{dialogModel>/PostalCode}" />
                                </f:fields>
                            </f:FormElement>
                            <f:FormElement label="Region" visible="{= !!${dialogModel>/Region} }">
                                <f:fields>
                                    <Text text="{dialogModel>/Region}" />
                                </f:fields>
                            </f:FormElement>
                            <f:FormElement label="Country">
                                <f:fields>
                                    <Text text="{dialogModel>/Country}" />
                                </f:fields>
                            </f:FormElement>
                        </f:formElements>
                    </f:FormContainer>
                    <f:FormContainer>
                        <f:FormElement label="Photo">
                            <f:fields>
                            <Image src="{path: 'dialogModel>/Photo', formatter: '.formatImage'}" width="12rem" height="12rem" />
                            </f:fields>
                        </f:FormElement>
                    </f:FormContainer>
                </f:formContainers>
            </f:Form>
        </VBox>
        <buttons>
            <Button text="Close" press="onClose"/>
        </buttons>
    </Dialog>
</core:FragmentDefinition>