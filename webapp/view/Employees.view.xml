<mvc:View controllerName="com.xtendhr.tilesexercise.tilesexercise.controller.Employees"
    xmlns:mvc="sap.ui.core.mvc"
	xmlns:core="sap.ui.core"
	xmlns:p="sap.m.plugins"
	xmlns:f="sap.f"
	xmlns:fb="sap.ui.comp.filterbar"
	xmlns:l="sap.ui.layout"
    xmlns="sap.m">
    
	<f:DynamicPage id="pageEmployees">
		<f:title>
			<f:DynamicPageTitle>
				<f:heading>
					 <HBox>
						<Button icon="sap-icon://nav-back" press="goBack" type="Transparent"/>
						<ToolbarSpacer width="1rem" />
						<Title text="{i18n>employeesTitle}" />
					</HBox>
				</f:heading>
				<f:navigationActions>
					<Button text="{i18n>productButtonNew}" press="openNew" type="Emphasized" />
				</f:navigationActions>
			</f:DynamicPageTitle>
		</f:title>
		<f:header>
			<f:DynamicPageHeader class="DynamicPageHeaderCustom" pinnable="false">
				<f:content>
				<HBox class="FilterBarHBox">
					<fb:FilterBar persistencyKey="" id="filterbarEmployees" useToolbar="false" showGoOnFB="false"
					showClearOnFB="false" showFilterConfiguration="false" >
						<fb:filterGroupItems>
							<fb:FilterGroupItem name="Name" label="Name" groupName="Group1" visibleInFilterBar="true">
								<fb:control>
									<Input id="searchEmployeeNameId" name="Name" change="onFilterTextChange" placeholder="Input text..." />
								</fb:control>
							</fb:FilterGroupItem>
						</fb:filterGroupItems>
					</fb:FilterBar>
					<HBox class="FilterBarButtons" justifyContent="SpaceBetween">
						<Button text="Clear" press="clearFilter" />
					</HBox>
				</HBox>
				</f:content>
			</f:DynamicPageHeader>
		</f:header>
		<f:content>
		<VBox class="centeredContainer">
			<Table id="idEmployeesTable" inset="false" items="{Employees>/value}" itemPress="openDetails">
				<columns>
					<Column id="emplIdCol" hAlign="Initial">
						<Text text="{i18n>employeeTableColId}" />
					</Column>
					<Column id="titleCol" hAlign="Begin">
						<Text text="{i18n>employeeTableColTitle}" />
					</Column>
					<Column id="regCol" hAlign="Center">
						<Text text="{i18n>employeeTableColRegion}"/>
					</Column>
					<Column id="hireDateCol" hAlign="Begin">
						<Text text="{i18n>employeeTableColDate}"/>
					</Column>
					<Column id="picCol" hAlign="Center">
						<Text text="{i18n>employeeTableColPhoto}" />
					</Column>
					<Column hAlign="Center">
						<Text text="{i18n>employeeTableColAction}" />
					</Column>
				</columns>
				<items>
					<ColumnListItem vAlign="Middle">
						<cells>
							<ObjectIdentifier title="{Employees>FirstName} {Employees>LastName}" text="ID: {Employees>EmployeeID}" />
                            <ObjectAttribute text="{Employees>Title}" />
							<ObjectAttribute text="{= ${Employees>Region} ? ${Employees>Region} + ', ' + ${Employees>Country} : ${Employees>Country}}"/> 
							<ObjectAttribute text="{path: 'Employees>HireDate', formatter: '.dateFormatter'}"/>
							<Image src="{path: 'Employees>Photo', formatter: '.formatImage'}" width="5rem" height="5rem"/>
							<VBox>
								<Button text="{i18n>employeeTableColButtonViewText}" width="50%" press="openDetails"/>
								<Button text="{i18n>employeeTableColButtonEditText}" width="50%" press="openEdit"/>
							</VBox>
						</cells>
					</ColumnListItem>
				</items>
			</Table>
		</VBox>
		</f:content>
    </f:DynamicPage>
</mvc:View>