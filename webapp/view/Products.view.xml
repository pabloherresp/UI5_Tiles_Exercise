<mvc:View controllerName="com.xtendhr.tilesexercise.tilesexercise.controller.Products"
    xmlns:mvc="sap.ui.core.mvc"
	xmlns:core="sap.ui.core"
	xmlns:p="sap.m.plugins"
    xmlns="sap.m">

    <Page class="page" id="pageProducts" title="{i18n>productsTitle}">
		<VBox class="centeredContainer">
			<Table id="idProductsTable" inset="false" items="{Products>/value}">
				<columns>
					<Column id="prodId">
						<Text text="Product ID" />
					</Column>
					<Column id="priceId" hAlign="End">
						<Text text="Price" />
					</Column>
				</columns>
				<items>
					<ColumnListItem vAlign="Middle">
						<cells>
							<ObjectIdentifier
								title="{Products>ProductName}"
								text="{Products>ProductID}" />
							<ObjectNumber
								number="{Products>UnitPrice}" />
						</cells>
					</ColumnListItem>
				</items>
			</Table>
		</VBox>
    </Page>
</mvc:View>