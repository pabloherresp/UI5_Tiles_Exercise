<mvc:View controllerName="com.xtendhr.tilesexercise.tilesexercise.controller.Home"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m">
    <Page id="pageHome" title="{i18n>title}">
    	<GenericTile class="sapUiTinyMarginBegin sapUiTinyMarginTop tileLayout" header="{i18n>productsTitle}" subheader="{i18n>productsSubheader}" press="pressProducts"/>
    	<GenericTile class="sapUiTinyMarginBegin sapUiTinyMarginTop tileLayout" header="{i18n>employeesTitle}" subheader="{i18n>employeesSubheader}" press="pressEmployees"/>
    </Page>
</mvc:View>